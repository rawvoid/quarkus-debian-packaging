<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <properties>
        <resources-plugin.version>3.5.0</resources-plugin.version>
        <jdeb-plugin.version>1.14</jdeb-plugin.version>

        <!-- Debian package properties -->
        <deb.package.name>$\{project.artifactId}</deb.package.name>
        <deb.install.dir>/usr/share/$\{deb.package.name}</deb.install.dir>
        <deb.config.dir>/etc/$\{deb.package.name}</deb.config.dir>
        <deb.data.dir>/var/lib/$\{deb.package.name}</deb.data.dir>
        <deb.log.dir>/var/log/$\{deb.package.name}</deb.log.dir>
        <deb.config.file>$\{deb.config.dir}/application.properties</deb.config.file>
        <deb.jvm.options.file>$\{deb.config.dir}/jvm.options</deb.jvm.options.file>
        <deb.defaults.file>/etc/default/$\{deb.package.name}</deb.defaults.file>
        <deb.bin.file>/usr/bin/$\{deb.package.name}</deb.bin.file>
        <deb.main.jar>$\{deb.install.dir}/quarkus-run.jar</deb.main.jar>
        <deb.service.user>$\{deb.package.name}</deb.service.user>
        <deb.service.user.group>$\{deb.package.name}</deb.service.user.group>
        <deb.systemd.service.name>$\{deb.package.name}.service</deb.systemd.service.name>
        <deb.systemd.unit.file>/usr/lib/systemd/system/$\{deb.systemd.service.name}</deb.systemd.unit.file>
        <deb.description>{#if project.description}{project.description}{#else}{project.artifact-id} service{/if}</deb.description>
        <deb.maintainer>Developer &lt;dev@developer.email&gt;</deb.maintainer>
        <deb.architecture>all</deb.architecture>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>$\{resources-plugin.version}</version>
                <executions>
                    <execution>
                        <id>filter-deb-data</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>$\{project.build.directory}/deb/data</outputDirectory>
                            <encoding>$\{project.build.sourceEncoding}</encoding>
                            <useDefaultDelimiters>false</useDefaultDelimiters>
                            <delimiters>
                                <delimiter>[[*]]</delimiter>
                            </delimiters>
                            <resources>
                                <resource>
                                    <directory>$\{project.basedir}/src/deb/data</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.vafer</groupId>
                <artifactId>jdeb</artifactId>
                <version>$\{jdeb-plugin.version}</version>
                <executions>
                    <execution>
                        <id>package-deb</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jdeb</goal>
                        </goals>
                        <configuration>
                            <deb>$\{project.build.directory}/$\{deb.package.name}_$\{project.version}_$\{deb.architecture}.deb</deb>
                            <controlDir>$\{project.basedir}/src/deb/control</controlDir>
                            <dataSet>
                                <data>
                                    <src>$\{project.build.directory}/quarkus-app</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>$\{deb.install.dir}</prefix>
                                        <filemode>0644</filemode>
                                        <dirmode>0755</dirmode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>$\{project.build.directory}/deb/data/usr/bin/$\{deb.package.name}</src>
                                    <type>file</type>
                                    <dst>$\{deb.bin.file}</dst>
                                    <mapper>
                                        <type>perm</type>
                                        <filemode>0755</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>$\{project.build.directory}/deb/data/usr/lib/systemd/system/$\{deb.package.name}.service</src>
                                    <type>file</type>
                                    <dst>$\{deb.systemd.unit.file}</dst>
                                    <mapper>
                                        <type>perm</type>
                                        <filemode>0644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>$\{project.build.directory}/deb/data/etc</src>
                                    <type>directory</type>
                                    <dst>$\{deb.config.dir}</dst>
                                    <conffile>true</conffile>
                                    <mapper>
                                        <type>perm</type>
                                        <filemode>0644</filemode>
                                    </mapper>
                                </data>
                            </dataSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
