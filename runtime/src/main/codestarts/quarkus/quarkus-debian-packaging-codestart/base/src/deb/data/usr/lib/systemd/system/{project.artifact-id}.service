[Unit]
Description=[[deb.description]]
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=[[deb.service.user]]
Group=[[deb.service.user.group]]

WorkingDirectory=-[[deb.install.dir]]
RuntimeDirectory=[[deb.service.user]]
StateDirectory=[[deb.service.user]]
LogsDirectory=[[deb.service.user]]
EnvironmentFile=-[[deb.defaults.file]]
ExecStart=[[deb.bin.file]]
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
