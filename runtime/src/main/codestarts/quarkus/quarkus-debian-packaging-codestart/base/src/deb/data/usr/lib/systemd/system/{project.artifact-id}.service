[Unit]
Description=[[deb.description]]
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=[[deb.service.user]]
Group=[[deb.service.user.group]]

WorkingDirectory=-[[deb.install.dir]]
EnvironmentFile=-[[deb.defaults.file]]
ExecStart=[[deb.bin.file]]
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

# To inspect the effective limit, run: systemctl show [[deb.systemd.service.name]] -p LimitNOFILE
LimitNOFILE=65535
# Allow the non-root user to bind to privileged ports (e.g., 80, 443)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
