#!/bin/sh
set -e

SERVICE_USER="[[deb.service.user]]"
SERVICE_GROUP="[[deb.service.user.group]]"
INSTALL_DIR="[[deb.install.dir]]"
CONFIG_DIR="[[deb.config.dir]]"
DATA_DIR="[[deb.data.dir]]"
LOG_DIR="[[deb.log.dir]]"

remove_service_account() {
    if getent passwd "${SERVICE_USER}" >/dev/null; then
        userdel "${SERVICE_USER}" >/dev/null 2>&1 || true
    fi

    if getent group "${SERVICE_GROUP}" >/dev/null; then
        groupdel "${SERVICE_GROUP}" >/dev/null 2>&1 || true
    fi
}

remove_directories() {
    rm -rf "${DATA_DIR}" "${LOG_DIR}" "${CONFIG_DIR}" "${INSTALL_DIR}" >/dev/null 2>&1 || true
}

case "$1" in
    purge)
        remove_directories
        remove_service_account
    ;;
esac

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

exit 0
