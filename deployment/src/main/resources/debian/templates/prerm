#!/bin/sh
set -e

PACKAGE_NAME="${packageName}"
SERVICE_NAME="${systemdServiceName}"

UPGRADE_RESTART_MARKER="/run/${PACKAGE_NAME}.upgrade-restart"

mark_service_for_upgrade_restart() {
    : > "${UPGRADE_RESTART_MARKER}"
}

clear_upgrade_restart_marker() {
    rm -f "${UPGRADE_RESTART_MARKER}"
}

if [ -d /run/systemd/system ]; then
    case "$1" in
        upgrade)
            clear_upgrade_restart_marker
            if systemctl --system is-active --quiet "${SERVICE_NAME}"; then
                mark_service_for_upgrade_restart
                systemctl --system stop "${SERVICE_NAME}" >/dev/null
            fi
        ;;
        remove)
            systemctl --system disable "${SERVICE_NAME}" >/dev/null || true
            systemctl --system stop "${SERVICE_NAME}" >/dev/null || true
            clear_upgrade_restart_marker
            ${hsPerfCleanup}
        ;;
    esac
fi

exit 0
